# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Default model for any agent without its own setting (see `ollama list`)
OLLAMA_MODEL=llama3.1

# Per-agent models (optional, override OLLAMA_MODEL)
COORDINATOR_MODEL=llama3.2
VOCABULARY_MODEL=llama3.1
GRAMMAR_MODEL=llama3.1
CONVERSATION_MODEL=llama3.1

# Optional: Only needed if using OpenAI as fallback
# OPENAI_API_KEY=sk-your-key-here
